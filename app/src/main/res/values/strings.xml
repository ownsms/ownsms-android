    <!-- About (AboutScreen.kt) -->
    <string name="about_what_title">Bu nima?</string>
    <string name="about_what_body">ownsms — o\'z telefoningiz SIM\'i orqali oddiy REST API bilan SMS yuborish imkonini beradi. Uchinchi tomon SMS-shlyuzi kerak emas: xabarni API orqali yuborasiz, ushbu telefon uni o\'z SIM\'idan jo\'natadi.</string>
    <string name="about_how_title">Qanday ishlaydi?</string>
    <string name="about_how_body">1. Serveringizga API so\'rov yuborasiz.\n2. Ushbu ilova serverdan yangi xabarlarni kutib turadi.\n3. Telefon SMS\'ni o\'z SIM\'i orqali yuboradi va holatini serverga qaytaradi.</string>
    <string name="about_website_btn">Veb-sayt — ownsms.uz</string>

    <!-- Guide (GuideScreen.kt) -->
    <string name="guide_intro">Quyidagi 5 qadamda telefoningizni SMS yuborishga tayyorlang.</string>
    <string name="guide_step1_title">Ruxsat va SIM</string>
    <string name="guide_step1_body">Sozlamalar bo\'limida SMS va telefon ruxsatlarini bering, batareya optimizatsiyasini o\'chiring. SIM bo\'limida standart SIM\'ni tanlang.</string>
    <string name="guide_step2_title">API URL</string>
    <string name="guide_step2_body">Server manzilini kiriting, masalan: https://sms.omadli.uz</string>
    <string name="guide_step3_title">Ro\'yxatdan o\'tish</string>
    <string name="guide_step3_body">«Yangi qurilma ro\'yxatdan o\'tkazish» tugmasini bosing. Qurilma serverga ulanadi va API kalit oladi.</string>
    <string name="guide_step4_title">API kalitni oling</string>
    <string name="guide_step4_body">Sozlamalar → Akkaunt bo\'limida API kalitni ko\'z tugmasi bilan oching va nusxa oling.</string>
    <string name="guide_step5_title">SMS yuboring</string>
    <string name="guide_step5_body">API kalit bilan quyidagi so\'rovni yuboring — telefon SMS\'ni o\'z SIM\'idan jo\'natadi.</string>
    <string name="guide_curl_label">cURL misoli (nusxa olib ishlating):</string>

